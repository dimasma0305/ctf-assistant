# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# Database Configuration (Optional - set NODB=true to disable)
MONGO_URI=mongodb://ctf_assistant:replace_with_app_password@mongo/test?authSource=test
# OR
DATABASE_URL=mongodb://localhost:27017/ctf-assistant
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace_with_root_password
MONGO_APP_USERNAME=ctf_assistant
MONGO_APP_PASSWORD=replace_with_app_password
MONGO_APP_DB=test

# Base64-encoded 32-byte key used to encrypt integration credentials in MongoDB.
INTEGRATION_ENCRYPTION_KEY=

# Immutable Discord role IDs, grouped by guild and logical role name.
DISCORD_ROLE_IDS_JSON={"guild_id":{"Mabar Manager":"role_id","Gas Mabar":"role_id"}}

# Public API resource controls
API_RATE_LIMIT_PER_MINUTE=180
API_EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
API_CACHE_MAX_ENTRIES=256

# Environment
NODE_ENV=development

# Optional Features
WARM_CACHE_ON_STARTUP=false
NODB=false

# Hackerika AI (DeepSeek API key; existing deployments use this variable name)
OPENAI_API_KEY=
# All roles default to DeepSeek V4.1 Flash (API name: deepseek-flash).
AI_CHAT_MODEL=deepseek-flash
# low/high/max (default high); max spends more reasoning time/tokens.
AI_REASONING_EFFORT=high
# Social autonomy is enabled by default. Set false to disable individually.
AI_PRIVATE_HANDOFF=true
AI_ALLOW_MESSAGE_REMOVAL=true
AI_ALLOW_IGNORING=true
AI_DISCORD_ACTIONS=true
# Contextual ambient replies/reactions; explicitly addressed messages still work.
AI_SMART_ATTENTION=true
# Native image understanding uses the same DeepSeek key.
AI_VISION=true
AI_VISION_MODEL=deepseek-flash
# Dedicated read-only research planner and evidence synthesis model.
AI_RESEARCH_MODEL=deepseek-flash
# Semantic benchmark judging; recorded historical runs keep their original model.
AI_JUDGE_MODEL=deepseek-flash

# Optional ChatGPT-plan provider. Complete the official sign-in helper first.
# When enabling it, set all AI_*_MODEL roles to the selected account model.
AI_PROVIDER=deepseek
CHATGPT_MODEL=gpt-6.1-sol
CHATGPT_REASONING_EFFORT=low
# Runtime-mounted private directory, writable for serialized token refresh.
CHATGPT_AUTH_FILE=/run/hackerika-chatgpt/credentials.json

# Instagram weekly profile update monitor (Bright Data)
# Store the API token in deployment secrets; never commit a real token.
BRIGHTDATA_API_TOKEN=
