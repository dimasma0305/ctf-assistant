# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# Database Configuration (Optional - set NODB=true to disable)
MONGODB_URI=mongodb://localhost:27017/ctf-assistant
# OR
DATABASE_URL=mongodb://localhost:27017/ctf-assistant

# Environment
NODE_ENV=development

# Optional Features
WARM_CACHE_ON_STARTUP=false
NODB=false

# Instagram weekly profile update monitor (Bright Data)
# Store the API token in deployment secrets; never commit a real token.
BRIGHTDATA_API_TOKEN=
