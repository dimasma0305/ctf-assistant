CHATGPT_AUTH_FILE=/root/app/ctf-assistant/runtime-secrets/chatgpt/credentials.json
CODEX_CONTROL_SOCKET=/run/hackerika-codex/control.sock
CODEX_SOCKET_GID=1000
CODEX_JOB_STATE_ROOT=/var/lib/hackerika-codex/jobs
CODEX_JOB_RUNTIME_ROOT=/run/hackerika-codex-jobs
CODEX_WORKER_IMAGE=hackerika-codex-worker:0.166.0-1
CODEX_VERIFIED_MODELS=gpt-5.6-sol,gpt-6.1-sol,gpt-daybreak-blue-latest
CODEX_DAYBREAK_USER_IDS=663394727688798231
CODEX_MAX_QUEUED=8
# Multiple independent responsibilities can coexist in one Discord conversation.
CODEX_MAX_CHANNEL_JOBS=4
CODEX_JOBS_PER_USER_HOUR=3
# 0 = unlimited submissions for CODEX_DAYBREAK_USER_IDS; public users retain
# CODEX_JOBS_PER_USER_HOUR as an anti-abuse boundary.
CODEX_TRUSTED_JOBS_PER_USER_HOUR=0
# 0 = no application wall-clock deadline; jobs remain cancellable.
CODEX_JOB_TIMEOUT_MS=0
# Optional paid Images API. Keep this key on the trusted host; never mount it in workers.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
